# ═══════════════════════════════════════════════════════════════════
# DNG SOLUTIONS — ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# 1. FRONTEND (VITE_ prefix — Visible in Browser)
# ───────────────────────────────────────────────────────────────────

# Firebase Client SDK (from Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=YOUR_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=YOUR_KEY_HERE
VITE_FIREBASE_PROJECT_ID=YOUR_KEY_HERE
VITE_FIREBASE_STORAGE_BUCKET=YOUR_KEY_HERE
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_KEY_HERE
VITE_FIREBASE_APP_ID=YOUR_KEY_HERE

# EmailJS (from emailjs.com -> Account -> API Keys)
VITE_EMAILJS_SERVICE_ID=YOUR_KEY_HERE
VITE_EMAILJS_TEMPLATE_ID=YOUR_KEY_HERE
VITE_EMAILJS_PUBLIC_KEY=YOUR_KEY_HERE

# ───────────────────────────────────────────────────────────────────
# 2. BACKEND (Server-side only — Hidden from Browser)
# ───────────────────────────────────────────────────────────────────

# Node Environment
NODE_ENV=YOUR_KEY_HERE

# Claude AI (Anthropic Console -> API Keys)
ANTHROPIC_API_KEY=YOUR_KEY_HERE

# Firebase Admin SDK (from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key)
# ⚠️ CRITICAL: FIREBASE_PRIVATE_KEY must be on ONE line with \n characters!
FIREBASE_PROJECT_ID=YOUR_KEY_HERE
FIREBASE_CLIENT_EMAIL=YOUR_KEY_HERE
FIREBASE_PRIVATE_KEY=YOUR_KEY_HERE

# Quickpay (from Quickpay Merchant Dashboard)
QUICKPAY_MERCHANT_ID=YOUR_KEY_HERE
QUICKPAY_API_KEY=YOUR_KEY_HERE

# Site URL (for Quickpay callbacks)
VITE_SITE_URL=YOUR_KEY_HERE