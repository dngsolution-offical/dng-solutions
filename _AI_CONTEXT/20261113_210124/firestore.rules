rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // ═══════════════ PUBLIC STATS (home dashboard) ═══════════════
    match /public_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════ USERNAMES (admin login lookup) ═══════════════
    match /usernames/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════ ADMIN ATTEMPTS (rate limiting) ═══════════════
    match /admin_attempts/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ═══════════════ USERS ═══════════════
    match /users/{userId} {
      allow read:   if owner(userId) || isAdmin();
      allow create: if owner(userId) && request.resource.data.uid == userId;
      allow update: if owner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════ RATINGS ═══════════════
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.resource.data.rating is number;
      allow update, delete: if isAdmin();
    }

    // ═══════════════ ORDERS ═══════════════
    match /orders/{orderId} {
      allow read:  if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ═══════════════ OTHER COLLECTIONS ═══════════════
    match /agent_history/{id} {
      allow read:  if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /agent_runs/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /agent_usage/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /agents/{agentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /priceList/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /schedules/{id} {
      allow read:  if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if signedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /reports/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /transactions/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /usage/{uid} {
      allow read: if owner(uid) || isAdmin();
      allow write: if false;
    }
    match /rate_limits/{uid} {
      allow read, write: if false;
    }

    // ═══════════════ DENY ALL ELSE ═══════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}