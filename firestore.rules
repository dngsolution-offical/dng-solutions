rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════ HELPERS ═══════════════
    function signedIn() {
      return request.auth != null;
    }
    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function notUpdatingSensitive() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny([
          'package','expiresAt','packageExpiresAt','lastPaymentId',
          'role','admin','uid','email','createdAt'
        ]);
    }

    // ═══════════════ PUBLIC STATS ═══════════════
    match /public_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════ USERNAMES ═══════════════
    match /usernames/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════ ADMIN ATTEMPTS ═══════════════
    match /admin_attempts/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ═══════════════ USERS ═══════════════
    match /users/{userId} {
      allow read:   if owner(userId) || isAdmin();
      allow create: if owner(userId) 
                    && request.resource.data.uid == userId
                    && request.resource.data.package == 'Free';
      allow update: if (owner(userId) && notUpdatingSensitive()) || isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════ RATINGS ═══════════════
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // ═══════════════ ORDERS ═══════════════
    match /orders/{orderId} {
      allow read:  if signedIn() 
                   && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ═══════════════ AGENT HISTORY ═══════════════
    match /agent_history/{id} {
      allow read:  if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /agent_runs/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /agent_usage/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ═══════════════ AGENTS CONFIG ═══════════════
    match /agents/{agentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════ PRICE LIST ═══════════════
    match /priceList/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════ SCHEDULES ═══════════════
    match /schedules/{id} {
      allow read:  if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId','task','frequency']);
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ═══════════════ REPORTS ═══════════════
    match /reports/{id} {
      allow read:  if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ═══════════════ TRANSACTIONS ═══════════════
    match /transactions/{id} {
      allow read:  if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ═══════════════ USAGE COUNTERS ═══════════════
    match /usage/{uid} {
      allow read:  if owner(uid) || isAdmin();
      allow write: if false;
    }

    // ═══════════════ RATE LIMITS (backend only) ═══════════════
    match /rate_limits/{uid} {
      allow read, write: if false;
    }

    // ═══════════════ DENY ALL ELSE ═══════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}